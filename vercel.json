{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/pathly.py": {
      "maxDuration": 60,
      "includeFiles": "backend/**",
      "excludeFiles": "{node_modules/**,.tools/**,tests/**,reports/**,backend/.env*,backend/.cache/**,backend/__pycache__/**,backend/test_*.py,backend/*response.json}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/pathly?__path=:path*" }
  ]
}
