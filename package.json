{
  "name": "pathly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:amap-live": "node tests/live/amap-smoke.mjs",
    "dev:api": "python3 backend/server.py",
    "dev:web": "vite --host 0.0.0.0",
    "test:global": "python3 -m unittest discover -s backend -p \"test_*.py\""
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.11.2",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
